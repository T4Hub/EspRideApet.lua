-- ================= COLOR ASSIGNMENT MAPPING =================
local function getEggColor(nameLower)
    if nameLower:find("galaxy") then
        return Color3.fromRGB(138, 43, 226) -- Purple / Violet
    elseif nameLower:find("gold") or nameLower:find("golden") then
        return Color3.fromRGB(255, 215, 0)   -- Gold / Yellow
    elseif nameLower:find("diamond") then
        return Color3.fromRGB(0, 255, 255)   -- Cyan / Bright Blue
    elseif nameLower:find("sinister") then
        return Color3.fromRGB(255, 0, 0)     -- Red
    elseif nameLower:find("slime") then
        return Color3.fromRGB(50, 205, 50)   -- Lime Green
    elseif nameLower:find("mushroom") then
        return Color3.fromRGB(255, 105, 180) -- Hot Pink
    elseif nameLower:find("flower") then
        return Color3.fromRGB(255, 192, 203) -- Pink
    elseif nameLower:find("skull") or nameLower:find("soul") then
        return Color3.fromRGB(128, 128, 128) -- Gray / Silver
    elseif nameLower:find("glass") or nameLower:find("ice") then
        return Color3.fromRGB(173, 216, 230) -- Light Blue
    elseif nameLower:find("stone") or nameLower:find("leaf") then
        return Color3.fromRGB(160, 82, 45)   -- Sienna / Earthy
    elseif nameLower:find("blackhole") then
        return Color3.fromRGB(75, 0, 130)    -- Indigo / Dark
    elseif nameLower:find("easter") then
        return Color3.fromRGB(255, 165, 0)   -- Orange
    else
        return Color3.fromRGB(255, 255, 255) -- Default White
    end
end

