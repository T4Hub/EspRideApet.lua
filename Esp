-- ================= ESP REWRITE (COLOR-CODED & FILTERED) =================
local espEnabled = false
local connections = {}

local function initESP()
    local Players = game:GetService("Players")
    local LocalPlayer = Players.LocalPlayer

    local function applyCustomESP(modelTarget)
        if not espEnabled then return end
        if modelTarget:IsA("Model") then
            local realName = modelTarget.Name
            local nameLower = string.lower(realName)

            local isRenderedEgg = modelTarget.Parent and modelTarget.Parent.Name == "RenderedEggs"
            local isTargetEgg = nameLower:find("egg") or nameLower:find("cherub")

            -- Exclude common/unwanted eggs, display/tracker items, dan egg fragment
            local isExcluded = nameLower:find("white egg") or 
                               nameLower:find("brown egg") or 
                               nameLower:find("cracked egg") or 
                               nameLower:find("displayegg") or 
                               nameLower:find("heldeggdisplay") or 
                               nameLower:find("eggo") or 
                               nameLower:find("eggtracker") or 
                               nameLower:find("eggfragment") or
                               nameLower:find("fragment")

            -- Exclude non-egg models or irrelevant items
            local isIgnored = nameLower:find("trex") or nameLower:find("t-rex") or nameLower:find("giraffe") or nameLower:find("cheetah") or nameLower:find("cerberus") or nameLower:find("unicorn") or nameLower:find("phoenix") or nameLower:find("dragon") or nameLower:find("player")

            if (isRenderedEgg or isTargetEgg) and not isExcluded and not isIgnored then
                if not modelTarget:FindFirstChild("TaufanCleanESP") then
                    local espFolder = Instance.new("Folder")
                    espFolder.Name = "TaufanCleanESP"
                    espFolder.Parent = modelTarget

                    -- Get specific color based on egg type
                    local assignedColor = getEggColor(nameLower)

                    -- Highlight with specific color
                    local highlight = Instance.new("Highlight")
                    highlight.Name = "HighlightESP"
                    highlight.Adornee = modelTarget
                    highlight.FillColor = assignedColor
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.4
                    highlight.OutlineTransparency = 0
                    highlight.Parent = espFolder

                    -- Safe BillboardGui for Distance Tag
                    local billboard = Instance.new("BillboardGui")
                    billboard.Name = "DistanceTag"
                    billboard.Adornee = modelTarget:FindFirstChild("Handle") or modelTarget:FindFirstChild("RootPart") or modelTarget
                    billboard.Size = UDim2.new(0, 150, 0, 40)
                    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
                    billboard.AlwaysOnTop = true

                    local textLabel = Instance.new("TextLabel")
                    textLabel.Name = "InfoText"
                    textLabel.Parent = billboard
                    textLabel.BackgroundTransparency = 1
                    textLabel.Size = UDim2.new(1, 0, 1, 0)
                    textLabel.Font = Enum.Font.GothamBold
                    textLabel.TextSize = 13
                    textLabel.TextColor3 = assignedColor
                    textLabel.TextStrokeTransparency = 0
                    textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                    textLabel.Text = realName

                    -- Real-time distance updater loop
                    local taskC = task.spawn(function()
                        while espEnabled and billboard and billboard.Parent and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") do
                            local successDist, distance = pcall(function()
                                return math.floor((LocalPlayer.Character.HumanoidRootPart.Position - modelTarget:GetPivot().Position).Magnitude)
                            end)
                            if successDist then
                                textLabel.Text = realName .. " [" .. distance .. "m]"
                            end
                            task.wait(0.4)
                        end
                    end)
                    table.insert(connections, taskC)

                    billboard.Parent = espFolder
                end
            end
        end
    end

    -- Scan RenderedEggs folder
    if renderedEggsFolder then
        for _, modelObj in pairs(renderedEggsFolder:GetChildren()) do
            applyCustomESP(modelObj)
        end

        local c1 = renderedEggsFolder.ChildAdded:Connect(function(modelObj)
            task.wait(0.2)
            applyCustomESP(modelObj)
        end)
        table.insert(connections, c1)
    end

    -- Scan whole Workspace to catch eggs elsewhere
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") then
            applyCustomESP(obj)
        end
    end

    local c2 = Workspace.DescendantAdded:Connect(function(obj)
        if obj:IsA("Model") then
            task.wait(0.2)
            applyCustomESP(obj)
        end
    end)
    table.insert(connections, c2)
end

local function clearESP()
    espEnabled = false
    local Workspace = game:GetService("Workspace")
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj.Name == "TaufanCleanESP" then
            obj:Destroy()
        end
    end
end

