-- ================= COLOR ASSIGNMENT MAPPING =================
local function getEggColor(nameLower)
    if nameLower:find("galaxy") then
        return Color3.fromRGB(138, 43, 226)
    elseif nameLower:find("gold") or nameLower:find("golden") then
        return Color3.fromRGB(255, 215, 0)
    elseif nameLower:find("diamond") then
        return Color3.fromRGB(0, 255, 255)
    elseif nameLower:find("sinister") then
        return Color3.fromRGB(255, 0, 0)
    elseif nameLower:find("slime") then
        return Color3.fromRGB(50, 205, 50)
    elseif nameLower:find("mushroom") then
        return Color3.fromRGB(255, 105, 180)
    elseif nameLower:find("flower") then
        return Color3.fromRGB(255, 192, 203)
    elseif nameLower:find("skull") or nameLower:find("soul") then
        return Color3.fromRGB(128, 128, 128)
    elseif nameLower:find("glass") or nameLower:find("ice") then
        return Color3.fromRGB(173, 216, 230)
    elseif nameLower:find("stone") or nameLower:find("leaf") then
        return Color3.fromRGB(160, 82, 45)
    elseif nameLower:find("blackhole") then
        return Color3.fromRGB(75, 0, 130)
    elseif nameLower:find("easter") then
        return Color3.fromRGB(255, 165, 0)
    else
        return Color3.fromRGB(255, 255, 255)
    end
end

-- ================= RARE EGG SPAWN DETECTOR =================
local trackedSpawnedEggs = {}

local function checkEggSpawn(modelTarget)
    if modelTarget and modelTarget:IsA("Model") then
        local realName = modelTarget.Name
        local nameLower = string.lower(realName)
        
        if nameLower:find("blackhole") or nameLower:find("cherub") then
            if not trackedSpawnedEggs[modelTarget] then
                trackedSpawnedEggs[modelTarget] = true
                
                sendAdvancedWebhook(
                    "🚨 EGG SPAWN DETECTED!",
                    "Egg langka **" .. realName .. "** baru saja spawn di server!\nSegera amankan sebelum keduluan player lain!",
                    "Target Spotted",
                    realName,
                    16711680,
                    true
                )
                
                modelTarget.Destroying:Connect(function()
                    trackedSpawnedEggs[modelTarget] = nil
                end)
            end
        end
    end
end

